{
  "name": "redhack-ai",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"server.ts\" \"scripts/**/*.ts\" && tsc --noEmit",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"server.ts\" \"scripts/**/*.ts\" --fix",
    "format:check": "prettier --check \"src/server/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"vitest.config.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,json,md}\"",
    "test": "vitest run && node --import tsx tests/run-tests.ts && node --import tsx tests/production-hardening.runner.ts",
    "test:vitest": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "node --import tsx tests/run-tests.ts && node --import tsx tests/production-hardening.runner.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "user:provision": "tsx scripts/provision-user.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vercel": "^62.2.0",
    "vitest": "^5.0.5"
  }
}
