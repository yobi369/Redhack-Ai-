# ==============================================================================
# REDHACK AI v2.1 — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure values before starting the application.
# Never commit real secrets, API keys, or production passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION (Mandatory)
# ------------------------------------------------------------------------------

# Application runtime environment: 'production' | 'development' | 'test'
NODE_ENV=development

# Server listening TCP port (1 - 65535)
PORT=3000

# Cryptographically strong secret for HMAC-SHA256 JWT tokens.
# IN PRODUCTION: Mandatory >= 32 random characters. Default/weak values are rejected at startup.
# IN DEVELOPMENT/TEST: If omitted, an ephemeral process-bound key is automatically generated.
JWT_SECRET=replace_with_cryptographically_secure_random_key_minimum_32_characters_for_prod

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE LAYER (Optional - Resilient In-Memory Fallback)
# ------------------------------------------------------------------------------

# PostgreSQL connection URI (PostgreSQL 14+, Neon, Supabase, Cloud SQL, AWS RDS)
# If omitted or unreachable, the system automatically falls back to the in-memory transactional store.
DATABASE_URL=postgresql://redhack_admin:secure_password_here@localhost:5432/redhack_enterprise?sslmode=disable

# ------------------------------------------------------------------------------
# 3. AI AGENT REASONING ENGINE (Optional - Deterministic Local Fallback)
# ------------------------------------------------------------------------------

# Google Gemini API Key for real-time generative SecOps intelligence.
# If omitted, agents operate using local deterministic security heuristics and offline models.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ------------------------------------------------------------------------------
# 4. EXTERNAL DEPLOYMENT & HOSTING (Optional)
# ------------------------------------------------------------------------------

# Public canonical URL of the deployed application
APP_URL=https://redhack-ai.vercel.app

# Vercel serverless marker (automatically injected by Vercel runtime)
# VERCEL=1

# ------------------------------------------------------------------------------
# 5. ENTERPRISE INTEGRATION CONNECTORS (Optional Feature-Specific)
# ------------------------------------------------------------------------------

# AWS GuardDuty & CloudTrail Connector
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1

# GitHub Code Security & Dependabot Connector
# GITHUB_TOKEN=ghp_example_token_for_scanning

# CrowdStrike Falcon EDR Connector
# FALCON_CLIENT_ID=falcon_client_id_here
# FALCON_CLIENT_SECRET=falcon_client_secret_here

# AlienVault OTX Threat Intelligence API
# OTX_API_KEY=alienvault_otx_api_key_here
