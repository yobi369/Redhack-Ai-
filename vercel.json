{
  "version": 2,
  "name": "redhack-ai",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/handler.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
